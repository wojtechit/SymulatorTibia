{
 "version": 3,
 "_schema": {
  "hp": "max hit points",
  "exp": "experience granted on kill (base, no stage multiplier)",
  "speed": "base speed, same unit as player speed (2 * (level - 1) + 110)",
  "armor": "physical armor; reduces physical damage only (Tibia blockHit rule)",
  "melee": "[min, max] physical melee damage per hit",
  "attack_interval_ms": "time between melee attacks",
  "elemental_resistances": "damage taken in percent: 100 = neutral, 0 = immune, 120 = 20% weakness, 80 = 20% resistance",
  "sprite": "optional TibiaWiki file name; default is {Name_With_Underscores}.gif",
  "spells": "optional list of area attacks: type beam|wave|ball, element, damage [min,max], cooldown_ms (attempt interval), chance (% per attempt), length (beam/wave: tiles in front), spread (wave: widens by 2 every N tiles), range + radius (ball, centred on the target)",
  "loot_value": "average gold value of the loot per kill (NPC sell prices), used for profit",
  "target_distance": "optional: ranged monster keeps this distance to the player (Canary targetDistance), default 1",
  "run_health": "optional: flees and stops melee while HP <= this (Canary runHealth)",
  "heals": "optional list: {heal: [min, max], cooldown_ms, chance} self-heal attempts",
  "melee_condition": "optional: {element, damage (total), interval_ms (per tick)} damage over time from a landed melee hit (poison, burning)",
  "spells.effect": "optional: damage (default) | dot (damage = total over ticks, dot_interval_ms) | slow (speed_change < 0, duration_ms)"
 },
